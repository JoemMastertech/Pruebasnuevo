{
  "version": "1.0.0",
  "description": "Configuración de umbrales de alerta para detección de fallas invisibles",
  "lastUpdated": "2025-01-22",
  "environment": {
    "development": {
      "strictMode": false,
      "allowExperimentalFiles": true,
      "description": "Configuración relajada para desarrollo"
    },
    "staging": {
      "strictMode": true,
      "allowExperimentalFiles": false,
      "description": "Configuración estricta para staging"
    },
    "production": {
      "strictMode": true,
      "allowExperimentalFiles": false,
      "description": "Configuración más estricta para producción"
    }
  },
  "thresholds": {
    "fileInventory": {
      "description": "Umbrales para validación de inventario de archivos",
      "critical": {
        "unauthorizedNewFiles": {
          "development": 10,
          "staging": 3,
          "production": 0,
          "description": "Número máximo de archivos nuevos no autorizados",
          "action": "Fallar build si se excede"
        },
        "suspiciousFilePatterns": {
          "development": 5,
          "staging": 2,
          "production": 0,
          "description": "Archivos con patrones sospechosos (.backup, .old, .tmp)",
          "action": "Fallar build si se excede"
        },
        "buildDirectoryViolations": {
          "development": 3,
          "staging": 1,
          "production": 0,
          "description": "Archivos problemáticos en directorio de build",
          "action": "Fallar build si se excede"
        }
      },
      "warning": {
        "modifiedFilesWithoutInventoryUpdate": {
          "development": 20,
          "staging": 10,
          "production": 5,
          "description": "Archivos modificados sin actualizar inventario",
          "action": "Generar advertencia"
        },
        "deletedApprovedFiles": {
          "development": 15,
          "staging": 8,
          "production": 3,
          "description": "Archivos aprobados que fueron eliminados",
          "action": "Generar advertencia"
        }
      }
    },
    "forcedSubstitution": {
      "description": "Umbrales para tests de sustitución forzada",
      "critical": {
        "hiddenDependenciesDetected": {
          "development": 5,
          "staging": 2,
          "production": 0,
          "description": "Dependencias ocultas detectadas",
          "action": "Fallar build si se excede"
        },
        "buildFailuresFromSubstitution": {
          "development": 3,
          "staging": 1,
          "production": 0,
          "description": "Fallas de build causadas por sustitución",
          "action": "Fallar build si se excede"
        }
      },
      "warning": {
        "testFailuresFromSubstitution": {
          "development": 10,
          "staging": 5,
          "production": 2,
          "description": "Fallas de tests causadas por sustitución",
          "action": "Generar advertencia"
        },
        "substitutionTimeouts": {
          "development": 5,
          "staging": 2,
          "production": 1,
          "description": "Tests que excedieron tiempo límite",
          "action": "Generar advertencia"
        }
      }
    },
    "bundleAnalysis": {
      "description": "Umbrales para análisis de bundle",
      "critical": {
        "obsoleteFilesInBundle": {
          "development": 5,
          "staging": 2,
          "production": 0,
          "description": "Archivos obsoletos incluidos en bundle final",
          "action": "Fallar build si se excede"
        },
        "bundleSizeIncreasePercent": {
          "development": 25,
          "staging": 15,
          "production": 10,
          "description": "Incremento porcentual en tamaño de bundle",
          "action": "Fallar build si se excede"
        }
      },
      "warning": {
        "unusedDependenciesInBundle": {
          "development": 10,
          "staging": 5,
          "production": 3,
          "description": "Dependencias no utilizadas en bundle",
          "action": "Generar advertencia"
        },
        "duplicateModulesInBundle": {
          "development": 8,
          "staging": 4,
          "production": 2,
          "description": "Módulos duplicados en bundle",
          "action": "Generar advertencia"
        },
        "bundleSizeAbsoluteMB": {
          "development": 10,
          "staging": 8,
          "production": 5,
          "description": "Tamaño absoluto de bundle en MB",
          "action": "Generar advertencia"
        }
      }
    },
    "e2eValidation": {
      "description": "Umbrales para validación E2E en entorno limpio",
      "critical": {
        "missingCriticalFiles": {
          "development": 3,
          "staging": 1,
          "production": 0,
          "description": "Archivos críticos faltantes que causan fallas",
          "action": "Fallar build si se excede"
        },
        "e2eTestFailures": {
          "development": 5,
          "staging": 2,
          "production": 0,
          "description": "Fallas en tests E2E en entorno limpio",
          "action": "Fallar build si se excede"
        }
      },
      "warning": {
        "performanceDegradationPercent": {
          "development": 30,
          "staging": 20,
          "production": 10,
          "description": "Degradación de performance en entorno limpio",
          "action": "Generar advertencia"
        },
        "missingOptionalFiles": {
          "development": 10,
          "staging": 5,
          "production": 3,
          "description": "Archivos opcionales faltantes",
          "action": "Generar advertencia"
        }
      }
    },
    "runtimeAnalysis": {
      "description": "Umbrales para análisis de runtime en staging",
      "critical": {
        "unexpectedModuleLoads": {
          "development": 10,
          "staging": 5,
          "production": 2,
          "description": "Módulos cargados no esperados",
          "action": "Fallar build si se excede"
        },
        "moduleLoadErrors": {
          "development": 3,
          "staging": 1,
          "production": 0,
          "description": "Errores al cargar módulos",
          "action": "Fallar build si se excede"
        }
      },
      "warning": {
        "slowModuleLoads": {
          "development": 15,
          "staging": 10,
          "production": 5,
          "description": "Módulos que tardan más de 2s en cargar",
          "action": "Generar advertencia"
        },
        "memoryLeaksDetected": {
          "development": 5,
          "staging": 3,
          "production": 1,
          "description": "Posibles memory leaks detectados",
          "action": "Generar advertencia"
        },
        "unusedModulesLoaded": {
          "development": 20,
          "staging": 10,
          "production": 5,
          "description": "Módulos cargados pero no utilizados",
          "action": "Generar advertencia"
        }
      }
    }
  },
  "alerting": {
    "channels": {
      "slack": {
        "enabled": true,
        "webhook": "${SLACK_WEBHOOK_URL}",
        "channel": "#devops-alerts",
        "criticalOnly": false
      },
      "email": {
        "enabled": true,
        "recipients": [
          "devops-team@company.com",
          "${CHANGE_AUTHOR_EMAIL}"
        ],
        "criticalOnly": true
      },
      "teams": {
        "enabled": false,
        "webhook": "${TEAMS_WEBHOOK_URL}",
        "criticalOnly": true
      }
    },
    "escalation": {
      "immediate": {
        "triggers": ["critical violations", "build failures"],
        "channels": ["slack", "email"]
      },
      "delayed": {
        "triggers": ["warning thresholds exceeded"],
        "channels": ["slack"],
        "delayMinutes": 30
      },
      "summary": {
        "triggers": ["daily summary", "weekly summary"],
        "channels": ["email"],
        "schedule": "0 9 * * 1-5"
      }
    }
  },
  "reporting": {
    "retention": {
      "reports": {
        "development": "7 days",
        "staging": "30 days",
        "production": "90 days"
      },
      "artifacts": {
        "development": "3 days",
        "staging": "14 days",
        "production": "30 days"
      }
    },
    "metrics": {
      "trackTrends": true,
      "baselineWindow": "30 days",
      "anomalyDetection": true,
      "exportToInfluxDB": false,
      "exportToPrometheus": true
    }
  },
  "maintenance": {
    "schedules": {
      "inventoryUpdate": {
        "frequency": "weekly",
        "day": "sunday",
        "time": "02:00",
        "autoApprove": false
      },
      "thresholdReview": {
        "frequency": "monthly",
        "day": "first-monday",
        "time": "10:00",
        "autoApprove": false
      },
      "reportCleanup": {
        "frequency": "daily",
        "time": "01:00",
        "autoApprove": true
      }
    },
    "automation": {
      "autoUpdateInventory": {
        "enabled": false,
        "conditions": ["no critical violations", "all tests pass"],
        "requiresApproval": true
      },
      "autoAdjustThresholds": {
        "enabled": false,
        "basedOnHistoricalData": true,
        "requiresApproval": true
      }
    }
  },
  "customRules": {
    "filePatterns": {
      "alwaysAllow": [
        "README.md",
        "LICENSE",
        ".gitignore",
        "package.json",
        "tsconfig.json"
      ],
      "alwaysBlock": [
        "*.backup",
        "*.old",
        "*.tmp",
        "*~",
        ".DS_Store",
        "Thumbs.db"
      ],
      "requireApproval": [
        "*.config.js",
        "*.env*",
        "docker*",
        "*file"
      ]
    },
    "directoryRules": {
      "protectedDirectories": [
        "src/",
        "lib/",
        "dist/",
        "build/"
      ],
      "temporaryDirectories": [
        "tmp/",
        "temp/",
        ".cache/",
        "node_modules/"
      ]
    }
  },
  "integration": {
    "cicd": {
      "failBuildOnCritical": true,
      "failBuildOnWarningCount": 10,
      "allowOverride": true,
      "overrideRequiresApproval": true
    },
    "monitoring": {
      "sendMetricsToDatadog": false,
      "sendMetricsToNewRelic": false,
      "sendMetricsToPrometheus": true,
      "customDashboard": true
    }
  }
}