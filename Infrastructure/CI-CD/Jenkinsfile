pipeline {
    agent any
    
    parameters {
        choice(
            name: 'ANALYSIS_LEVEL',
            choices: ['basic', 'full', 'deep'],
            description: 'Nivel de análisis de fallas invisibles'
        )
        booleanParam(
            name: 'FORCE_E2E_VALIDATION',
            defaultValue: false,
            description: 'Forzar validación E2E incluso en commits menores'
        )
        booleanParam(
            name: 'UPDATE_INVENTORY',
            defaultValue: false,
            description: 'Actualizar inventario aprobado después de validación exitosa'
        )
    }
    
    environment {
        NODE_VERSION = '18'
        VERBOSE = 'true'
        ANALYSIS_TIMESTAMP = sh(script: 'date +"%Y%m%d-%H%M%S"', returnStdout: true).trim()
    }
    
    options {
        timeout(time: 45, unit: 'MINUTES')
        retry(1)
        skipDefaultCheckout(false)
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '5'))
    }
    
    triggers {
        // Análisis completo cada lunes a las 2 AM
        cron('0 2 * * 1')
        // Análisis básico en cada push a develop
        pollSCM('H/5 * * * *')
    }
    
    stages {
        stage('Preparación') {
            steps {
                script {
                    echo "🔍 Iniciando detección de fallas invisibles"
                    echo "Nivel de análisis: ${params.ANALYSIS_LEVEL}"
                    echo "Branch: ${env.BRANCH_NAME}"
                    echo "Commit: ${env.GIT_COMMIT}"
                }
                
                // Instalar Node.js
                sh '''
                    curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION}.x | sudo -E bash -
                    sudo apt-get install -y nodejs
                    node --version
                    npm --version
                '''
                
                // Instalar dependencias
                sh 'npm ci'
            }
        }
        
        stage('Validación de Inventario') {
            steps {
                script {
                    echo "📋 Validando inventario de archivos..."
                }
                
                sh 'node cicd-preventive-rules.js validate'
                
                // Archivar reporte
                archiveArtifacts artifacts: 'cicd-validation-report-*.json', fingerprint: true
            }
            
            post {
                failure {
                    script {
                        currentBuild.result = 'FAILURE'
                        echo "❌ Validación de inventario falló - violaciones críticas detectadas"
                    }
                }
            }
        }
        
        stage('Tests de Sustitución Forzada') {
            when {
                anyOf {
                    expression { params.ANALYSIS_LEVEL in ['full', 'deep'] }
                    expression { env.BRANCH_NAME == 'main' }
                    expression { env.BRANCH_NAME == 'develop' }
                }
            }
            
            steps {
                script {
                    echo "🧪 Ejecutando tests de sustitución forzada..."
                }
                
                // Generar análisis si existe el script
                sh '''
                    if [ -f "review-unreferenced-files.ps1" ]; then
                        pwsh -File review-unreferenced-files.ps1 -Mode report || true
                    fi
                '''
                
                // Ejecutar tests de sustitución
                sh '''
                    if [ -f "unreferenced-files-analysis-*.json" ]; then
                        ANALYSIS_FILE=$(ls unreferenced-files-analysis-*.json | head -1)
                        node forced-substitution-test.js --batch --analysis "$ANALYSIS_FILE"
                    else
                        echo "⚠️ No se encontró archivo de análisis, omitiendo tests de sustitución"
                    fi
                '''
                
                archiveArtifacts artifacts: 'forced-substitution-report-*.json', fingerprint: true, allowEmptyArchive: true
            }
        }
        
        stage('Análisis de Bundle') {
            parallel {
                stage('Configurar Analyzer') {
                    steps {
                        sh 'node bundle-analyzer-setup.js'
                    }
                }
                
                stage('Build Proyecto') {
                    steps {
                        script {
                            // Intentar build si existe script
                            sh '''
                                if [ -f "package.json" ] && grep -q '"build"' package.json; then
                                    npm run build
                                else
                                    echo "⚠️ No se encontró script de build, omitiendo"
                                fi
                            '''
                        }
                    }
                }
            }
            
            post {
                always {
                    script {
                        // Detectar archivos obsoletos
                        sh '''
                            if [ -f "detect-obsolete-in-bundle.js" ]; then
                                node detect-obsolete-in-bundle.js || true
                            fi
                        '''
                        
                        archiveArtifacts artifacts: 'bundle-analysis-report-*.json,obsolete-files-report-*.json', 
                                       fingerprint: true, allowEmptyArchive: true
                    }
                }
            }
        }
        
        stage('Validación E2E en Entorno Limpio') {
            when {
                anyOf {
                    expression { params.FORCE_E2E_VALIDATION }
                    expression { params.ANALYSIS_LEVEL == 'deep' }
                    expression { env.BRANCH_NAME == 'main' }
                    triggeredBy 'TimerTrigger'
                }
            }
            
            steps {
                script {
                    echo "🎭 Ejecutando validación E2E en entorno limpio..."
                }
                
                timeout(time: 20, unit: 'MINUTES') {
                    sh 'node e2e-clean-environment-validator.js'
                }
                
                archiveArtifacts artifacts: 'e2e-validation-report-*.json', fingerprint: true
            }
        }
        
        stage('Análisis de Runtime en Staging') {
            when {
                anyOf {
                    expression { env.BRANCH_NAME == 'develop' }
                    expression { params.ANALYSIS_LEVEL == 'deep' }
                    triggeredBy 'TimerTrigger'
                }
            }
            
            environment {
                STAGING_URL = credentials('staging-url')
            }
            
            steps {
                script {
                    echo "🔍 Ejecutando análisis de runtime en staging..."
                }
                
                sh 'node setup-staging-logger.js'
                
                archiveArtifacts artifacts: 'runtime-module-report-*.json,staging-logger-report-*.json', 
                               fingerprint: true, allowEmptyArchive: true
            }
        }
        
        stage('Consolidación de Reportes') {
            steps {
                script {
                    echo "📊 Consolidando reportes..."
                    
                    // Crear reporte consolidado
                    sh '''
                        echo "# 📊 Reporte Consolidado de Detección de Fallas Invisibles" > consolidated-report.md
                        echo "" >> consolidated-report.md
                        echo "**Fecha:** $(date)" >> consolidated-report.md
                        echo "**Build:** ${BUILD_NUMBER}" >> consolidated-report.md
                        echo "**Branch:** ${BRANCH_NAME}" >> consolidated-report.md
                        echo "**Commit:** ${GIT_COMMIT}" >> consolidated-report.md
                        echo "**Nivel de análisis:** ${ANALYSIS_LEVEL}" >> consolidated-report.md
                        echo "" >> consolidated-report.md
                        
                        # Contar reportes
                        TOTAL_REPORTS=$(find . -name "*-report-*.json" | wc -l)
                        echo "**Total de reportes generados:** $TOTAL_REPORTS" >> consolidated-report.md
                        echo "" >> consolidated-report.md
                        
                        # Verificar violaciones críticas
                        CRITICAL_VIOLATIONS=0
                        if find . -name "*.json" -exec grep -l '"severity":"error"' {} \; | head -1 > /dev/null; then
                            CRITICAL_VIOLATIONS=1
                            echo "## 🚨 VIOLACIONES CRÍTICAS DETECTADAS" >> consolidated-report.md
                            echo "" >> consolidated-report.md
                            echo "Se encontraron violaciones críticas que requieren atención inmediata." >> consolidated-report.md
                            echo "" >> consolidated-report.md
                        fi
                        
                        echo "CRITICAL_VIOLATIONS=$CRITICAL_VIOLATIONS" > violations.env
                    '''
                    
                    // Leer resultado de violaciones
                    def violationsEnv = readFile('violations.env').trim()
                    env.CRITICAL_VIOLATIONS = violationsEnv.split('=')[1]
                    
                    archiveArtifacts artifacts: 'consolidated-report.md', fingerprint: true
                }
            }
        }
        
        stage('Actualizar Inventario') {
            when {
                allOf {
                    expression { params.UPDATE_INVENTORY }
                    expression { env.CRITICAL_VIOLATIONS != '1' }
                    expression { currentBuild.result != 'FAILURE' }
                }
            }
            
            steps {
                script {
                    echo "📋 Actualizando inventario aprobado..."
                }
                
                sh 'node cicd-preventive-rules.js update-inventory'
                
                // Commit del inventario actualizado
                sh '''
                    git config user.name "Jenkins CI"
                    git config user.email "jenkins@company.com"
                    git add approved-files-inventory.json
                    git commit -m "chore: actualizar inventario aprobado [skip ci]" || true
                    git push origin ${BRANCH_NAME} || true
                '''
            }
        }
    }
    
    post {
        always {
            script {
                echo "🏁 Pipeline de detección de fallas invisibles completado"
                
                // Publicar resultados
                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: '.',
                    reportFiles: 'consolidated-report.md',
                    reportName: 'Reporte de Fallas Invisibles'
                ])
            }
        }
        
        success {
            script {
                if (env.CRITICAL_VIOLATIONS == '1') {
                    currentBuild.result = 'UNSTABLE'
                    echo "⚠️ Build marcado como UNSTABLE debido a violaciones críticas"
                } else {
                    echo "✅ No se detectaron fallas invisibles críticas"
                }
            }
        }
        
        failure {
            script {
                echo "❌ Pipeline falló - revisar logs para detalles"
                
                // Notificar por email
                emailext (
                    subject: "🚨 Fallas Invisibles Detectadas - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                    body: """Se detectaron fallas invisibles en el proyecto que requieren atención inmediata.
                    
                    Build: ${env.BUILD_URL}
                    Branch: ${env.BRANCH_NAME}
                    Commit: ${env.GIT_COMMIT}
                    
                    Por favor, revisar los reportes generados y corregir las violaciones antes del próximo deployment.""",
                    to: "${env.CHANGE_AUTHOR_EMAIL},devops-team@company.com"
                )
            }
        }
        
        unstable {
            script {
                echo "⚠️ Build inestable - violaciones detectadas pero no críticas"
                
                // Notificar por Slack si está configurado
                if (env.SLACK_WEBHOOK_URL) {
                    sh '''
                        curl -X POST -H 'Content-type: application/json' \
                            --data '{
                                "text": "⚠️ Violaciones detectadas en ${JOB_NAME}",
                                "attachments": [
                                    {
                                        "color": "warning",
                                        "fields": [
                                            {
                                                "title": "Build",
                                                "value": "${BUILD_NUMBER}",
                                                "short": true
                                            },
                                            {
                                                "title": "Branch",
                                                "value": "${BRANCH_NAME}",
                                                "short": true
                                            }
                                        ],
                                        "actions": [
                                            {
                                                "type": "button",
                                                "text": "Ver Build",
                                                "url": "${BUILD_URL}"
                                            }
                                        ]
                                    }
                                ]
                            }' \
                            ${SLACK_WEBHOOK_URL}
                    '''
                }
            }
        }
        
        cleanup {
            script {
                // Limpiar archivos temporales
                sh '''
                    rm -f violations.env
                    find . -name "*-temp-*" -delete || true
                    find . -name "*.tmp" -delete || true
                '''
            }
        }
    }
}